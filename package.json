{
	"name": "n8n-nodes-skrap",
	"version": "0.1.0",
	"description": "Skrap.ai for n8n: verify email addresses and find verified work emails.",
	"license": "MIT",
	"homepage": "https://skrap.ai/docs/n8n",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"email verification",
		"email verifier",
		"email finder",
		"skrap"
	],
	"author": {
		"name": "Skrap.ai",
		"email": "support@skrap.ai"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/skrapai/n8n-nodes-skrap.git"
	},
	"bugs": {
		"url": "https://github.com/skrapai/n8n-nodes-skrap/issues",
		"email": "support@skrap.ai"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:tsc": "tsc -p tsconfig.json",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "tsc -p tsconfig.json && node --test test/node.test.js",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"version": "node scripts/sync-client-version.js"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SkrapApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Skrap/Skrap.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.56.2",
		"eslint": "9.32.0",
		"n8n-workflow": "2.16.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
